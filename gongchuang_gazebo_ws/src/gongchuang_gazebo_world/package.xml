<?xml version="1.0"?>
<package format="3">
  <name>gongchuang_gazebo_world</name><version>0.5.0</version>
  <description>Source-grounded 2027 Gongchuang preliminary competition field for Gazebo Harmonic.</description>
  <maintainer email="maintainer@example.invalid">Gongchuang simulation team</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend condition="$ROS_DISTRO != 'humble'">gz_sim_vendor</depend>
  <depend condition="$ROS_DISTRO != 'humble'">gz_plugin_vendor</depend>
  <!-- Humble uses OSRF libgz-sim8-dev / libgz-plugin2-dev; see docs/ubuntu22.04.md. -->
  <exec_depend>ros_gz_sim</exec_depend><exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>launch_ros</exec_depend><exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-pil</exec_depend><exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend><exec_depend>tf2_ros</exec_depend>
  <test_depend>ament_cmake_test</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
